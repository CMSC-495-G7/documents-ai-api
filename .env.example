# Local development only. Compose works without this file.
# Copy to .env only to customize settings; never commit .env.
DOCUMENTS_AI_API_PORT=8000
DJANGO_SECRET_KEY=local-dev-only-change-before-deploying-documents-ai
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Compose uses these credentials for both containers. Changing them does not
# update users/databases in an existing database volume.
POSTGRES_DB=documents_ai
POSTGRES_USER=documents_ai
POSTGRES_PASSWORD=documents_ai

# JWT lifetimes
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Test logins for seed_identity (local only)
SEED_ADMIN_EMAIL=admin@acme.example
SEED_ADMIN_PASSWORD=admin-local-only
SEED_EMPLOYEE_EMAIL=employee@acme.example
SEED_EMPLOYEE_PASSWORD=employee-local-only

# Biggest file an admin can upload, in MB
DOCUMENT_MAX_UPLOAD_MB=16

# POST /api/ask uses an OpenAI-compatible embedding and chat provider.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the provider used by the defaults below.
# ASK_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ASK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ASK_EMBEDDING_MODEL=gemini-embedding-2
ASK_EMBEDDING_DIMENSIONS=3072
ASK_EMBEDDING_TIMEOUT_SECONDS=10
ASK_LLM_MODEL=gemini-3.1-flash-lite
ASK_LLM_TIMEOUT_SECONDS=30
ASK_MAX_ANSWER_TOKENS=1024
ASK_MAX_CONTEXT_CHUNKS=6
# Cosine similarity floor. Below this, /api/ask skips the LLM.
ASK_SIMILARITY_CUTOFF=0.35
